includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - modules/

    level: 7

    excludePaths:
        # Module test suites are glue: they reach into other modules'
        # factories/models by design. The pattern must match FILES (fnmatch
        # matches the whole path), hence the trailing *.
        - modules/*/tests/*
