{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/blank-react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Shared\\App\\": "modules/Shared/app/",
            "Modules\\Shared\\Database\\": "modules/Shared/database/",
            "Modules\\Shared\\Tests\\": "modules/Shared/tests/",
            "Modules\\Platform\\App\\": "modules/Platform/app/",
            "Modules\\Platform\\Database\\": "modules/Platform/database/",
            "Modules\\Platform\\Database\\Factories\\": "modules/Platform/database/factories/",
            "Modules\\Platform\\Database\\Seeders\\": "modules/Platform/database/seeders/",
            "Modules\\Platform\\Tests\\": "modules/Platform/tests/",
            "Modules\\Identity\\App\\": "modules/Identity/app/",
            "Modules\\Identity\\Database\\": "modules/Identity/database/",
            "Modules\\Identity\\Database\\Factories\\": "modules/Identity/database/factories/",
            "Modules\\Identity\\Database\\Seeders\\": "modules/Identity/database/seeders/",
            "Modules\\Identity\\Tests\\": "modules/Identity/tests/",
            "Modules\\Core\\App\\": "modules/Core/app/",
            "Modules\\Core\\Database\\": "modules/Core/database/",
            "Modules\\Core\\Database\\Factories\\": "modules/Core/database/factories/",
            "Modules\\Core\\Database\\Seeders\\": "modules/Core/database/seeders/",
            "Modules\\Core\\Tests\\": "modules/Core/tests/",
            "Modules\\Attendance\\App\\": "modules/Attendance/app/",
            "Modules\\Attendance\\Database\\": "modules/Attendance/database/",
            "Modules\\Attendance\\Database\\Factories\\": "modules/Attendance/database/factories/",
            "Modules\\Attendance\\Database\\Seeders\\": "modules/Attendance/database/seeders/",
            "Modules\\Attendance\\Tests\\": "modules/Attendance/tests/",
            "Modules\\Ppdb\\App\\": "modules/Ppdb/app/",
            "Modules\\Ppdb\\Database\\": "modules/Ppdb/database/",
            "Modules\\Ppdb\\Database\\Factories\\": "modules/Ppdb/database/factories/",
            "Modules\\Ppdb\\Database\\Seeders\\": "modules/Ppdb/database/seeders/",
            "Modules\\Ppdb\\Tests\\": "modules/Ppdb/tests/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\Identity\\Tests\\": "modules/Identity/tests/",
            "Modules\\Platform\\Tests\\": "modules/Platform/tests/",
            "Modules\\Core\\Tests\\": "modules/Core/tests/",
            "Modules\\Attendance\\Tests\\": "modules/Attendance/tests/",
            "Modules\\Ppdb\\Tests\\": "modules/Ppdb/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bash script/toggle_env.sh local",
            "@php artisan config:clear --ansi",
            "@php artisan dev"
        ],
        "prod": [
            "Composer\\Config::disableProcessTimeout",
            "bash script/toggle_env.sh production",
            "@php artisan config:clear --ansi",
            "npm run build",
            "@php artisan optimize --ansi"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "deptrac": [
            "deptrac analyse --no-progress"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run check",
            "npm run types:check",
            "@test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@deptrac",
            "@php artisan test"
        ],
        "test:e2e": [
            "Composer\\Config::disableProcessTimeout",
            "npm run build",
            "@php vendor/bin/pest -c phpunit.e2e.xml"
        ],
        "test:playwright": [
            "Composer\\Config::disableProcessTimeout",
            "npm run build",
            "npx playwright test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}
